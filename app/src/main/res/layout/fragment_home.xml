<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/yamusBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textColor="?attr/yamusText"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/yamusCard"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="@dimen/home_avatar"
                    android:layout_height="@dimen/home_avatar"
                    android:background="?attr/yamusCardElevated"
                    android:contentDescription="@string/me_title"
                    android:padding="16dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/ic_person" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/accountName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/yamusText"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/accountEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/yamusTextSub"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/yamusCardElevated"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/home_card_padding">

                <ru.yamus.app.ui.common.IconView
                    android:layout_width="@dimen/home_wave_icon"
                    android:layout_height="@dimen/home_wave_icon"
                    app:srcCompat="@drawable/ic_wave"
                    app:yamusTint="?attr/yamusAccent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/wave_title"
                    android:textColor="?attr/yamusText"
                    android:textSize="@dimen/home_wave_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/waveState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/wave_off"
                    android:textColor="?attr/yamusTextSub"
                    android:textSize="14sp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/waveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/yamusAccent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <!-- Ширина по тексту, но не шире карточки: на узких экранах
                         шрифт уменьшается, чтобы надпись не переносилась. -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/waveButtonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minWidth="168dp"
                        android:paddingLeft="20dp"
                        android:paddingTop="12dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="12dp"
                        android:text="@string/wave_off"
                        android:textColor="?attr/yamusOnAccent"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/waveSeedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/waveSeedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="?attr/yamusText"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/waveNormalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingLeft="16dp"
                        android:paddingTop="8dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/wave_back_normal"
                        android:textColor="?attr/yamusAccent"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_hint_margin"
            android:gravity="center"
            android:text="@string/wave_hint"
            android:textColor="?attr/yamusTextSub"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
