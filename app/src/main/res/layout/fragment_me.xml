<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/yamusBg"
    android:orientation="vertical">

    <!-- Приглашение псевдотерминала: видно только в стиле «Терминал». -->
    <LinearLayout
        android:id="@+id/terminalPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/terminalPromptText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/yamusAccent"
            android:textSize="13sp" />

        <ru.yamus.app.ui.common.TerminalCursorView
            android:id="@+id/terminalPromptCursor"
            android:layout_width="8dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/me_title"
            android:textColor="?attr/yamusText"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ru.yamus.app.ui.common.IconView
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_settings"
            app:yamusTint="?attr/yamusText" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/likedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/yamusCard"
        app:cardCornerRadius="?attr/yamusCorner"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="?attr/yamusAccent"
                app:cardCornerRadius="?attr/yamusCornerSmall"
                app:cardElevation="0dp">

                <ru.yamus.app.ui.common.IconView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_heart"
                    app:yamusTint="?attr/yamusOnAccent" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/liked_tracks"
                    android:textColor="?attr/yamusText"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/likedCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/yamusTextSub"
                    android:textSize="12sp" />
            </LinearLayout>

            <ru.yamus.app.ui.common.IconView
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_chevron_right"
                app:yamusTint="?attr/yamusTextSub" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/downloadsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/yamusCard"
        app:cardCornerRadius="?attr/yamusCorner"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="?attr/yamusCardElevated"
                app:cardCornerRadius="?attr/yamusCornerSmall"
                app:cardElevation="0dp">

                <ru.yamus.app.ui.common.IconView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_downloaded"
                    app:yamusTint="?attr/yamusAccent" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/downloads_title"
                    android:textColor="?attr/yamusText"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/downloadsValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/yamusTextSub"
                    android:textSize="12sp" />
            </LinearLayout>

            <ru.yamus.app.ui.common.IconView
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_chevron_right"
                app:yamusTint="?attr/yamusTextSub" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/playlistsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="4dp"
        android:text="@string/playlists"
        android:textColor="?attr/yamusTextSub"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/meEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/no_playlists"
            android:textColor="?attr/yamusTextSub"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/meProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
