<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="?attr/yamusRowPadding"
        android:paddingRight="12dp"
        android:paddingBottom="?attr/yamusRowPadding">

        <ImageView
            android:id="@+id/artistAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/yamusCard"
            android:contentDescription="@string/search_artists"
            android:padding="12dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_person" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/artistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/yamusText"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/artistMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/yamusTextSub"
                android:textSize="12sp" />
        </LinearLayout>

        <ru.yamus.app.ui.common.IconView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_chevron_right"
            app:yamusTint="?attr/yamusTextSub" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="?attr/yamusRowDivider"
        android:background="?attr/yamusDivider" />
</LinearLayout>
