<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/avatarCircle"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp">

        <ru.yamus.app.ui.common.IconView
            android:id="@+id/avatarFallback"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_person"
            app:yamusTint="?attr/yamusAccent" />

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/search_artists"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/artistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="24dp"
        android:gravity="center"
        android:textColor="?attr/yamusText"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/allTracksRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <ru.yamus.app.ui.common.IconView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/yamusCard"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_music"
            app:yamusTint="?attr/yamusAccent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_tracks"
                android:textColor="?attr/yamusText"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/allTracksCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/yamusTextSub"
                android:textSize="12sp" />
        </LinearLayout>

        <ru.yamus.app.ui.common.IconView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_chevron_right"
            app:yamusTint="?attr/yamusTextSub" />
    </LinearLayout>
</LinearLayout>
