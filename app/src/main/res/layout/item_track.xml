<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="?attr/yamusRowPadding"
        android:paddingRight="4dp"
        android:paddingBottom="?attr/yamusRowPadding">

        <ImageView
            android:id="@+id/trackCover"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/yamusCard"
            android:contentDescription="@string/search_tracks"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/yamusText"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/trackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/yamusTextSub"
                android:textSize="12sp" />
        </LinearLayout>

        <ru.yamus.app.ui.common.IconView
            android:id="@+id/trackPlaying"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="6dp"
            android:contentDescription="@string/now_playing"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_equalizer"
            app:yamusTint="?attr/yamusAccent" />

        <ru.yamus.app.ui.common.IconView
            android:id="@+id/trackOffline"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginRight="4dp"
            android:contentDescription="@string/offline_badge"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_downloaded"
            app:yamusTint="?attr/yamusAccent" />

        <TextView
            android:id="@+id/trackFormat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:textColor="?attr/yamusTextSub"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/trackDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:textColor="?attr/yamusTextSub"
            android:textSize="11sp" />

        <ru.yamus.app.ui.common.IconView
            android:id="@+id/trackMore"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackground"
            android:padding="11dp"
            app:srcCompat="@drawable/ic_more"
            app:yamusTint="?attr/yamusTextSub" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="?attr/yamusRowDivider"
        android:background="?attr/yamusDivider" />
</LinearLayout>
