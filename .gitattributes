# Нормализуем переводы строк: в репозитории — LF.
* text=auto eol=lf

# Windows-скрипты должны оставаться с CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Бинарные файлы не трогаем.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.zip binary
